/* ============================================================
   CACHING (keeps the dashboard fast for many people at once)
   ============================================================ */

function getCachedSheetData(sheetName) {
  return getCachedSheets_([sheetName])[sheetName] || [];
}

function clearSheetCache(sheetNames, options) {
  options = options || {};
  const preserveFastPinIndex = !!options.preserveFastPinIndex;
  const targeted = Array.isArray(sheetNames) && sheetNames.length;
  const names = targeted ? sheetNames.slice() : CACHEABLE_SHEETS.slice();
  const publicChanged = !targeted || names.some(function(name) {
    return name === CONFIG.CATEGORIES_SHEET || name === CONFIG.LINKS_SHEET || name === CONFIG.LOGOS_SHEET;
  });
  const usersChanged = !targeted || names.indexOf(CONFIG.USERS_SHEET) !== -1;

  names.forEach(function(name) { delete SHEET_DATA_MEMO_[name]; });
  if (usersChanged) USER_INDEX_MEMO_ = null;

  try {
    const cache = CacheService.getScriptCache();
    const directKeys = [];
    if (publicChanged) directKeys.push(DASHBOARD_BUNDLE_KEY);
    if (usersChanged && !preserveFastPinIndex) directKeys.push(FAST_PIN_INDEX_KEY);
    if (directKeys.length) cache.removeAll(directKeys);

    const bases = names.map(function(name) { return 'sheet_' + name; });
    if (usersChanged && !preserveFastPinIndex) bases.push(FAST_PIN_INDEX_KEY);
    if (bases.length) {
      const metas = cache.getAll(bases.map(function(b) { return b + '_meta'; })) || {};
      const chunkKeys = [];
      bases.forEach(function(base) {
        const count = parseInt(metas[base + '_meta'] || '0', 10) || 0;
        if (count) chunkKeys.push(base + '_meta');
        for (let i = 0; i < count; i++) chunkKeys.push(base + '_' + i);
      });
      if (chunkKeys.length) cache.removeAll(chunkKeys);
    }
  } catch (err) {
    // Cache maintenance must never block a form or spreadsheet edit.
  }
}

function getUserDashboard(pin, e) {
  const rawPin = String(pin || '').trim();
  if (!rawPin) return apiResponse(e, { success: false, error: 'PIN required' });

  const user = rawPin.toLowerCase() === 'guest'
    ? { ParticipantID:'', PIN:'guest', Name:'Guest Scout', Username:'GuestScout', Email:'', Password:'', AllowedCategories:'*', Status:'Active', PaperworkStatus:'Not Required' }
    : findUserByPinFast_(rawPin);

  if (!user) return apiResponse(e, { success: false, error: 'PIN not found' });
  if (String(user.Status || '').trim().toLowerCase() === 'disabled') {
    return apiResponse(e, { success: false, error: 'This account has been disabled.' });
  }

  const bundle = getDashboardBundle_();
  return apiResponse(e, {
    success: true,
    user: {
      ParticipantID: user.ParticipantID || '',
      PIN: user.PIN || '',
      Name: user.Name || '',
      Username: user.Username || '',
      Email: String(user.Email || '').trim(),
      Password: String(user.Password || ''),
      AllowedCategories: '*',
      Status: user.Status || '',
      PaperworkStatus: user.PaperworkStatus || ''
    },
    categories: bundle.categories,
    links: bundle.links,
    logos: bundle.logos,
    unofficial: true,
    organiser: CONFIG.SCOUT_GROUP
  });
}

function loginUser(pin, e) {
  const rawPin = String(pin || '').trim();
  if (!rawPin) return apiResponse(e, { success: false, error: 'PIN required' });

  const user = rawPin.toLowerCase() === 'guest'
    ? { ParticipantID:'', PIN:'guest', Name:'Guest Scout', Username:'GuestScout', Email:'', Password:'', Status:'Active', PaperworkStatus:'Not Required' }
    : findUserByPinFast_(rawPin);

  if (!user) return apiResponse(e, { success: false, error: 'PIN not found' });
  if (String(user.Status || '').trim().toLowerCase() === 'disabled') {
    return apiResponse(e, { success: false, error: 'This account has been disabled.' });
  }

  return apiResponse(e, {
    success: true,
    loggingInAs: user.Name || 'Scout',
    user: {
      ParticipantID: user.ParticipantID || '',
      PIN: user.PIN || '',
      Name: user.Name || '',
      Username: user.Username || '',
      Email: String(user.Email || '').trim(),
      Password: String(user.Password || ''),
      AllowedCategories: '*',
      Status: user.Status || '',
      PaperworkStatus: user.PaperworkStatus || ''
    }
  });
}

