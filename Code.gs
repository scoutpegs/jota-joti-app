function getSectionFormUrl(ageGroup) {
  const text = String(ageGroup || '').trim().toLowerCase();
  if (text.includes('joey')) return CONFIG.JOEY_FORMS_URL;
  if (text.includes('cub')) return CONFIG.CUB_FORMS_URL;
  if (text.includes('vent')) return CONFIG.VENTURER_FORMS_URL;
  return CONFIG.SCOUT_FORMS_URL;
}

function getSectionFormName(ageGroup) {
  const text = String(ageGroup || '').trim().toLowerCase();
  if (text.includes('joey')) return 'Joey Scouts';
  if (text.includes('cub')) return 'Cub Scouts';
  if (text.includes('vent')) return 'Venturer Scouts';
  return 'Scouts';
}

